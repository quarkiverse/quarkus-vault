<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.vault</groupId>
        <artifactId>quarkus-vault-parent</artifactId>
        <version>999-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>quarkus-vault-docs-rag</artifactId>
    <name>Documentation RAG</name>
    <description>RAG vector embeddings for documentation</description>

    <properties>
        <guides.dir>${project.basedir}/../docs/modules/ROOT/pages</guides.dir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-extension-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-extension-descriptor</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-documentation-rag-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-extension-rag</id>
                        <configuration>
                            <extensionName>quarkus-vault</extensionName>
                            <guides>
                                <guide>${guides.dir}/index.adoc</guide>
                                <guide>${guides.dir}/vault-auth.adoc</guide>
                                <guide>${guides.dir}/vault-transit.adoc</guide>
                                <guide>${guides.dir}/vault-pki.adoc</guide>
                                <guide>${guides.dir}/vault-datasource.adoc</guide>
                            </guides>
                            <guideBaseUrl>https://docs.quarkiverse.io/quarkus-vault/dev</guideBaseUrl>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
